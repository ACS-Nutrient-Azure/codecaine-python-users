# MyPage Service 환경변수 예시
# cp .env.example .env 후 실제 값으로 채울 것

APP_NAME=MyPage Service
APP_ENV=development
APP_PORT=8003

# ── Database (필수) ───────────────────────────────────────────────────────────
# asyncpg 드라이버 사용
DATABASE_URL=postgresql+asyncpg://vitamin_user:<password>@<host>:5432/vitamin_user

# ── Entra External ID — JWT 인증 (필수) ──────────────────────────────────────
# 설정 시 RS256 JWKS 검증. 미설정 시 JWT_SECRET_KEY로 HS256 fallback (개발 전용)
# COGNITO_USER_POOL_ID엔 Entra 테넌트 ID(GUID)를 넣음 (이름은 예전 그대로 유지)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ENTRA_TENANT_SUBDOMAIN=
AWS_REGION=ap-northeast-2

# ── JWT fallback — Cognito 미설정 시 개발 전용 ────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256

# ── AWS — Textract OCR (영양제 성분표 스캔, 선택) ─────────────────────────────
# 미설정 시 /api/users/supplements/scan 엔드포인트 사용 불가
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── CODEF ────────────────────────────────────────────────────────────────────
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# 개발: https://development.codef.io / 운영: https://api.codef.io

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


